{
  "key": "bassolioporto",
  "name": "Bassoli Oporto",
  "base_url": "https://www.bassolioporto.pt",
  "extraction_mode": "direct",
  "pagination_type": "query_param",
  "pagination_param": "pag",
  "use_js_render": true,
  "link_pattern": "^https://www\\.bassolioporto\\.pt/imovel/[^/?#]+/\\d+/?$",
  "image_filter": "images\\.egorealestate\\.com/.*/Tphoto/",
  "schedule_start_url": "https://www.bassolioporto.pt/imoveis",
  "schedule_max_pages": 15,
  "selectors": {
    "listing_link_selector": ".propertyItem a[href^='/imovel/']",
    "title_selector": "h1",
    "price_selector": ".propertyPrice.uneprice",
    "description_selector": ".specsText",
    "images_selector": ".thumbsWrapper img.Streamed",
    "property_id_selector": "li.detailItem:has(span.label:-soup-contains('Referência')) span.value",
    "property_type_selector": "li.detailItem:has(span.label:-soup-contains('Natureza')) span.value",
    "typology_selector": "li.detailItem:has(span.label:-soup-contains('Tipologia')) span.value",
    "condition_selector": "li.detailItem:has(span.label:-soup-contains('Estado')) span.value",
    "district_selector": "li.detailItem:has(span.label:-soup-contains('Distrito')) span.value",
    "county_selector": "li.detailItem:has(span.label:-soup-contains('Concelho')) span.value",
    "parish_selector": "li.detailItem:has(span.label:-soup-contains('Freguesia')) span.value",
    "area_selector": "li.detailItem:has(span.label:-soup-contains('Área útil')) span.value",
    "gross_area_selector": "li.detailItem:has(span.label:-soup-contains('Área Bruta')) span.value",
    "land_area_selector": "li.detailItem:has(span.label:-soup-contains('Área do terreno')) span.value",
    "energy_certificate_selector": "li.detailItem:has(span.label:-soup-contains('Categoria Energética')) i.energyClass",
    "construction_year_selector": "li.detailItem:has(span.label:-soup-contains('Ano construção')) span.value",
    "bedrooms_selector": "li.detailItem:has(span.label:-soup-contains('Total quarto')) span.value",
    "bathrooms_selector": "li.detailItem:has(span.label:-soup-contains('Casa(s) de Banho')) span.value"
  }
}
